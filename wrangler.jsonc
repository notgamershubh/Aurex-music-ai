{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aurex-music-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-10-31",
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  }
}
